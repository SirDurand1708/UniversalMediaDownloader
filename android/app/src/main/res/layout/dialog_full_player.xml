<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutFullPlayerRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/spotify_black"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Indicador de arrastre superior -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_input_box" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:fontFamily="sans-serif-bold"
        android:letterSpacing="0.06"
        android:text="✦ REPRODUCIENDO EN TU BÓVEDA"
        android:textColor="@color/vault_cyan"
        android:textSize="11sp" />

    <!-- Gran Carátula con Resplandor -->
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/imgFullPlayerCover"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="14dp"
        android:background="@color/spotify_card_elevated"
        android:scaleType="centerCrop"
        android:src="@mipmap/ic_launcher"
        app:shapeAppearanceOverlay="@style/Rounded12"
        app:strokeColor="@color/vault_purple"
        app:strokeWidth="2dp" />

    <TextView
        android:id="@+id/tvFullPlayerTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:ellipsize="marquee"
        android:fontFamily="sans-serif-black"
        android:gravity="center"
        android:marqueeRepeatLimit="marquee_forever"
        android:singleLine="true"
        android:text="Título de la Canción"
        android:textColor="@color/text_primary"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/tvFullPlayerArtist"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:text="Artista de la Canción"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <!-- Barra de Tiempo y Progreso -->
    <SeekBar
        android:id="@+id/seekBarPlayer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:progressTint="@color/vault_cyan"
        android:thumbTint="@color/vault_cyan" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp">

        <TextView
            android:id="@+id/tvCurrentTime"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif"
            android:text="00:00"
            android:textColor="@color/text_muted"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tvTotalDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:text="00:00"
            android:textColor="@color/text_muted"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Controles Principales de Reproducción (Shuffle, Prev, Play, Next, Repeat) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnPlayerShuffle"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Aleatorio"
            android:src="@android:drawable/ic_menu_sort_by_size"
            app:tint="@color/text_muted" />

        <ImageButton
            android:id="@+id/btnPlayerPrev"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Anterior"
            android:src="@android:drawable/ic_media_previous"
            app:tint="@color/text_primary" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabPlayPause"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:contentDescription="Reproducir o pausar"
            android:src="@android:drawable/ic_media_play"
            app:backgroundTint="@color/vault_cyan"
            app:elevation="4dp"
            app:tint="#0A0B0D" />

        <ImageButton
            android:id="@+id/btnPlayerNext"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Siguiente"
            android:src="@android:drawable/ic_media_next"
            app:tint="@color/text_primary" />

        <ImageButton
            android:id="@+id/btnPlayerRepeat"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Repetir"
            android:src="@android:drawable/ic_menu_rotate"
            app:tint="@color/text_muted" />
    </LinearLayout>

    <!-- CONTROL DE SUPER VOLUMEN 300% (Estilo Lark Player) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_input_box"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-black"
                android:text="🔊 SUPER VOLUMEN (BOOST 300%)"
                android:textColor="@color/vault_cyan"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvVolumeBoostBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_titanium_card"
                android:fontFamily="sans-serif-black"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:text="100% NORMAL"
                android:textColor="@color/vault_cyan"
                android:textSize="10sp" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/seekBarVolumeBoost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:max="300"
            android:progress="100"
            android:progressTint="@color/vault_cyan"
            android:thumbTint="@color/vault_cyan" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:text="0% Silencio"
                android:textColor="@color/text_muted"
                android:textSize="9sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="100% Normal"
                android:textColor="@color/vault_cyan"
                android:textSize="9sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-black"
                android:gravity="end"
                android:text="300% SUPER BOOST"
                android:textColor="@color/vault_magenta"
                android:textSize="9sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Botones de Acción Extra: Letras, Ecualizador y Compartir -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnToggleLyrics"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif-bold"
            android:text="🎤 Letras"
            android:textColor="@color/vault_cyan"
            android:textSize="11sp"
            app:backgroundTint="@color/spotify_card_elevated"
            app:cornerRadius="20dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnToggleEqualizer"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif-bold"
            android:text="🎛️ Ecualizador"
            android:textColor="@color/vault_purple"
            android:textSize="11sp"
            app:backgroundTint="@color/spotify_card_elevated"
            app:cornerRadius="20dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFullPlayerShare"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:text="↗ Compartir"
            android:textColor="@color/text_primary"
            android:textSize="11sp"
            app:backgroundTint="@color/spotify_card_elevated"
            app:cornerRadius="20dp" />
    </LinearLayout>

    <!-- PANEL DE ECUALIZADOR & BASS BOOST (Desplegable) -->
    <LinearLayout
        android:id="@+id/layoutEqualizerPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_spotify_card"
        android:orientation="vertical"
        android:padding="14dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:text="🎛️ ECUALIZADOR POR HARDWARE (AUDIOFX)"
            android:textColor="@color/vault_purple"
            android:textSize="11sp" />

        <!-- Fader 1: Bass Boost -->
        <TextView
            android:id="@+id/tvBassBoostLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="sans-serif-medium"
            android:text="Refuerzo de Graves (Bass Boost): +0 dB"
            android:textColor="@color/text_secondary"
            android:textSize="10sp" />

        <SeekBar
            android:id="@+id/seekBassBoost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="1000"
            android:progress="0"
            android:progressTint="@color/vault_purple"
            android:thumbTint="@color/vault_purple" />

        <!-- Fader 2: Virtualizador 3D -->
        <TextView
            android:id="@+id/tvVirtualizerLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="sans-serif-medium"
            android:text="Sonido Envolvente 3D (Virtualizer): 0%"
            android:textColor="@color/text_secondary"
            android:textSize="10sp" />

        <SeekBar
            android:id="@+id/seekVirtualizer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="1000"
            android:progress="0"
            android:progressTint="@color/vault_magenta"
            android:thumbTint="@color/vault_magenta" />
    </LinearLayout>

    <!-- Vista Desplegable de Letras Karaoke -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollLyrics"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_spotify_card"
        android:padding="12dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvLyricsContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:text="Buscando letras..."
            android:textColor="@color/text_primary"
            android:textSize="13sp" />
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
