<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardVideoRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_spotify_card"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Miniatura 16:9 con Play Overlay y Badge de Calidad -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="180dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/imgVideoThumbnail"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/spotify_card_elevated"
            android:scaleType="centerCrop"
            android:src="@mipmap/ic_launcher"
            app:shapeAppearanceOverlay="@style/Rounded12" />

        <!-- Overlay sombreado degradado -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_input_box"
            android:alpha="0.2" />

        <!-- Botón Central de Play -->
        <ImageView
            android:id="@+id/btnVideoPlayOverlay"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_centerInParent="true"
            android:background="@drawable/bg_btn_gradient"
            android:padding="12dp"
            android:src="@android:drawable/ic_media_play"
            app:tint="#0A0C14" />

        <!-- Badge de Resolución (Ej. 1080p FHD) -->
        <TextView
            android:id="@+id/tvVideoResolutionBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:layout_margin="10dp"
            android:background="@drawable/bg_auto_detect_badge"
            android:fontFamily="sans-serif-black"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="1080p FHD"
            android:textColor="@color/vault_cyan"
            android:textSize="10sp" />

        <!-- Duración (Ej. 03:45) -->
        <TextView
            android:id="@+id/tvVideoDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:layout_margin="10dp"
            android:background="#B3000000"
            android:fontFamily="sans-serif-bold"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:text="00:00"
            android:textColor="@color/text_primary"
            android:textSize="10sp" />
    </RelativeLayout>

    <!-- Detalles del Video -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvVideoTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-bold"
                android:maxLines="2"
                android:text="Título del Video en Tu Bóveda"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvVideoSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif"
                android:text="YouTube • MP4 • 45.2 MB"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnVideoShare"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Compartir"
            android:src="@android:drawable/ic_menu_share"
            app:tint="@color/vault_cyan" />
    </LinearLayout>

</LinearLayout>
